# Mock-first defaults. Never commit real credentials.
OPENAI_USE_MOCK=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ZOOMINFO_PROVIDER=mock
ZOOMINFO_MCP_URL=https://mcp.zoominfo.com/mcp
ZOOMINFO_MCP_CLIENT_ID=
ZOOMINFO_MCP_CLIENT_SECRET=
ZOOMINFO_MCP_REDIRECT_URI=http://localhost:3000/api/integrations/zoominfo/callback
ZOOMINFO_TOKEN_ENCRYPTION_KEY=
ZOOMINFO_REFRESH_ACCOUNT_LIMIT=5
ZOOMINFO_SIGNAL_LOOKBACK_DAYS=90
ZOOMINFO_CACHE_TTL_MINUTES=1440
ZOOMINFO_MCP_TIMEOUT_MS=30000
ZOOMINFO_INTENT_TOPIC_QUERIES=artificial intelligence,generative AI,digital transformation,cloud migration,data analytics

# Added automatically when Upstash Redis is linked through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SIGNAL_OUTREACH_REDIS_PREFIX=signal-outreach:v1

SLACK_USE_MOCK=true
SIGNAL_PROVIDER_TIMEOUT_MS=8000
